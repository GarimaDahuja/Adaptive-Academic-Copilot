# Flask Server Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=change-me-in-production-use-a-strong-random-key

# Database Configuration (PostgreSQL + pgvector)
# Later milestone: postgresql://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/academic_copilot

# Generative AI (Gemini API)
# Later milestone: Obtain an API key from Google AI Studio
GEMINI_API_KEY=your_gemini_api_key_here
